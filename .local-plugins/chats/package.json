{
  "name": "@local/chats",
  "version": "0.1.0",
  "description": "Chats component for Quartz - AI chat interface with sidebar history",
  "type": "module",
  "license": "MIT",
  "author": "Custom",
  "files": ["dist", "README.md", "LICENSE"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "preact": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "preact": {
      "optional": false
    }
  },
  "dependencies": {
    "@quartz-community/types": "github:quartz-community/types",
    "@quartz-community/utils": "github:quartz-community/utils"
  },
  "devDependencies": {
    "esbuild": "^0.27.2",
    "preact": "^10.28.2",
    "sass": "^1.97.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10.9.2"
  },
  "quartz": {
    "name": "chats",
    "displayName": "Chats",
    "category": ["component", "pageType"],
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 30,
    "defaultEnabled": true,
    "defaultOptions": {
      "proxyUrl": "/api",
      "title": "Chats"
    },
    "components": {
      "Chats": {
        "displayName": "Chats Sidebar",
        "defaultPosition": "left",
        "defaultPriority": 40
      },
      "ChatPage": {
        "displayName": "Chat Page"
      }
    },
    "optionSchema": {
      "proxyUrl": {
        "type": "string"
      },
      "title": {
        "type": "string"
      }
    }
  }
}
