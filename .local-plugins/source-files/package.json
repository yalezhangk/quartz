{
  "name": "@local/source-files",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "tsx --test src/*.test.ts"
  },
  "devDependencies": {
    "@quartz-community/types": "github:quartz-community/types",
    "@types/node": "^25.0.10",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10.9.2"
  },
  "quartz": {
    "name": "source-files",
    "displayName": "Source Files",
    "description": "Publishes manual and historical source files explicitly referenced by published Source pages.",
    "category": "emitter",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 60,
    "defaultEnabled": true,
    "defaultOptions": {}
  }
}
